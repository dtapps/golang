# ===================================================================
# Golang 构建环境镜像（不含 fnpack）
#
# 三个平台各留一份：.cnb/docker/Dockerfile.golang、.github/docker/Dockerfile.golang 与
# .gitlab/docker/Dockerfile.golang，各自维护、不互相引用。
# 装包、升级工具版本时三处都要改；GitHub / GitLab 侧一律直连官方源，CNB 侧才用国内镜像。
#
# 镜像内容：
#   Go 工具链 + UPX + nfpm + Node.js/pnpm
#   + sqlc / ent / golangci-lint / govulncheck / shfmt / dockerfmt / yamlfmt
#   + gojq / sql-formatter / gotestsum / markdownfmt
#   + gocover-cobertura / gcov2lcov（覆盖率报告转换）
#   + task（go-task：Taskfile 任务运行器）
#   + wixl（编译 Windows MSI 用）
#
# 工具版本默认 latest，构建时自动解析最新版（详见下方版本变量注释块）。
# ===================================================================

# GO_VERSION 默认 1 = golang:1-trixie 浮动标签，自动跟随最新稳定 Go（跨大版本）。
# 钉版本传 1.27 或 1.27.3。构建脚本会把解析出的实际 Go 版本写进镜像标签。
ARG GO_VERSION=1
ARG DEBIAN_VERSION=trixie
FROM golang:${GO_VERSION}-${DEBIAN_VERSION}

# BuildKit 自动提供的目标平台（linux/amd64、linux/arm64 …）。多架构构建时同一个
# RUN 会按架构各跑一遍，echo 带上它才能分清当前是哪个架构、不会误以为重复安装。
ARG TARGETPLATFORM

# FROM 之前声明的 ARG 在构建阶段不可见，必须在此重新声明才能用于 LABEL
ARG GO_VERSION
ARG DEBIAN_VERSION
ARG IMAGE_VERSION=dev
ARG VCS_REF=unknown
# 默认值取固定纪元时间而非当前时间：不传参时同一份源码构建出同样的镜像 config
ARG BUILD_DATE=1970-01-01T00:00:00Z
# 基础镜像的 manifest digest（CI 解析后传入）
ARG BASE_DIGEST=unknown
# 本镜像所在的代码仓库（OCI source/url），由构建脚本传入
ARG IMAGE_SOURCE

# ==========================================
# 工具版本：默认 latest，CI 会先解析成具体版本号再传进来。
#
# 为什么 CI 要先解析：层缓存是按 build-arg 的「值」算缓存键的。每天都传字符串
# latest，缓存键永远不变，层会一直命中第一次构建的产物，工具再也不会升级。
# 所以 .gitlab/scripts/build-golang.sh 先在构建之前把 latest 解析成 v1.31.1 这种
# 具体版本，再以 --build-arg 传入——没发新版就全命中，发新版才重建那一层。
# 这里的 latest 默认值只是「不经过 CI 的裸 docker build」的兜底，此时由下面
# 各步骤在构建时自行解析，行为和改造前一致（慢，但正确）。
#
# 出问题时可钉回具体版本：--build-arg SQLC_VERSION=v1.31.1（或改这里的默认值）
#
# latest 的解析渠道（jq 在第 2 步安装）：
#   UPX        releases.atom 第一个稳定 tag（不走 api.github.com：免认证、
#              无 60 次/小时限速，解析命令与 GitHub 侧完全一致）
#   Node       nodejs.org/dist/index.json 第一个非预发布版本（过滤 -alpha/-rc）
#   nfpm       go install @latest（走 GOPROXY；钉版本格式 vX.Y.Z）
#   Go 工具链  go install @latest（模块路径含 /v2、/v3，不会自动跳 major）
#   pnpm       npm registry 的 pnpm@latest
#
# https://github.com/upx/upx/releases
# https://github.com/goreleaser/nfpm/releases
# https://github.com/nodejs/node/releases
# https://github.com/pnpm/pnpm/releases
# https://github.com/ent/ent/releases
# https://github.com/sqlc-dev/sqlc/releases
# https://github.com/golangci/golangci-lint/releases
# https://go.googlesource.com/vuln
# https://github.com/mvdan/sh/releases
# https://github.com/reteps/dockerfmt/releases
# https://github.com/google/yamlfmt/releases
# https://github.com/itchyny/gojq/releases
# https://github.com/wasilibs/go-sql-formatter/releases
# https://github.com/gotestyourself/gotestsum/releases
# https://github.com/Kunde21/markdownfmt/releases
# https://github.com/boumenot/gocover-cobertura/releases
# https://github.com/jandelgado/gcov2lcov/releases
# ==========================================
ARG UPX_VERSION=latest
ARG NFPM_VERSION=latest
ARG NODE_VERSION=latest
ARG PNPM_VERSION=latest
ARG ENT_VERSION=latest
ARG SQLC_VERSION=latest
ARG GOLANGCI_LINT_VERSION=latest
ARG GOVULNCHECK_VERSION=latest
ARG SHFMT_VERSION=latest
ARG DOCKERFMT_VERSION=latest
ARG YAMLFMT_VERSION=latest
ARG GOJQ_VERSION=latest
ARG GOSQLFORMATTER_VERSION=latest
ARG GOTESTSUM_VERSION=latest
ARG MARKDOWNFMT_VERSION=latest
ARG GOCOVER_COBERTURA_VERSION=latest
ARG GCOV2LCOV_VERSION=latest
ARG TASK_VERSION=latest

# 1. 设置 Go 环境变量
ENV GOPATH=/go \
    PATH="$GOPATH/bin:$PATH"

# 1.1 时区与语言：容器内统一北京时间 + UTF-8，构建日志与产物时间戳才对得上
#（tzdata 在下一步装；${TZ} 由本 ENV 提供，apt 那段直接用它建 /etc/localtime）
ENV TZ=Asia/Shanghai \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# 2. 安装基础构建工具（含 tzdata，配合上面的 TZ）
# xz-utils / zstd：.tar.xz（UPX、Node）与 .tar.zst 的打包解压；zstd 当前无调用，先预留
# build-essential / libc6-dev：显式钉住 gcc / g++ / make / libc6-dev 这套 cgo 工具链，
#   不依赖上游 golang 镜像的内部实现；libc6-dev 与元包重复，显式声明、apt 幂等
# dpkg-dev：dpkg-buildpackage / dpkg-architecture 等 .deb 源码构建工具，nfpm 不需要，先预留
# fakeroot / desktop-file-utils：debuild / dpkg-buildpackage -rfakeroot 与 .desktop 校验注册，先预留
# wixl / wixl-data：编译 Windows MSI 安装包（msitools，替代 Windows 上的 WiX）
RUN set -eu; \
    export DEBIAN_FRONTEND=noninteractive; \
    apt_packages=" \
    wget \
    xz-utils \
    zstd \
    ca-certificates \
    curl \
    gnupg \
    git \
    make \
    build-essential \
    libc6-dev \
    jq \
    zip \
    unzip \
    pkg-config \
    dpkg-dev \
    fakeroot \
    desktop-file-utils \
    tzdata \
    wixl \
    wixl-data \
    file \
    patchelf \
    chrpath \
    lintian \
    rpm"; \
    apt-get update; \
    apt-get install -y --no-install-recommends ${apt_packages}; \
    rm -rf /var/lib/apt/lists/*; \
    ln -snf "/usr/share/zoneinfo/${TZ}" /etc/localtime; \
    printf '%s\n' "${TZ}" > /etc/timezone; \
    date; \
    echo "[${TARGETPLATFORM:-unknown}] --- apt 包版本 ---"; \
    dpkg-query -W ${apt_packages}

# 3. 安装 UPX 工具
RUN set -eux; \
    ARCH="$(uname -m)"; \
    case "$ARCH" in \
    x86_64) UPX_ARCH="amd64" ;; \
    aarch64) UPX_ARCH="arm64" ;; \
    *) echo "[${TARGETPLATFORM:-unknown}] 不支持的架构: $ARCH" >&2; exit 1 ;; \
    esac; \
    GH="https://github.com"; \
    if [ "${UPX_VERSION}" = "latest" ]; then \
    UPX_TAG="$(curl -fsSL "${GH}/upx/upx/releases.atom" \
    | grep -oE 'releases/tag/v[0-9]+\.[0-9]+\.[0-9]+"' | head -n 1 \
    | sed 's|.*/tag/||; s|"||')"; \
    else UPX_TAG="v${UPX_VERSION}"; fi; \
    case "${UPX_TAG}" in \
    v[0-9]*) : ;; \
    *) echo "[${TARGETPLATFORM:-unknown}] 无法解析 UPX 版本（UPX_VERSION=${UPX_VERSION}，得到：${UPX_TAG:-空}）" >&2; exit 1 ;; \
    esac; \
    UPX_VER="${UPX_TAG#v}"; \
    UPX_DIR="upx-${UPX_VER}-${UPX_ARCH}_linux"; \
    UPX_URL="${GH}/upx/upx/releases/download/${UPX_TAG}/${UPX_DIR}.tar.xz"; \
    wget -q -O /tmp/upx.tar.xz "${UPX_URL}"; \
    tar -xJf /tmp/upx.tar.xz -C /tmp; \
    mv "/tmp/${UPX_DIR}/upx" /usr/local/bin/upx; \
    chmod +x /usr/local/bin/upx; \
    rm -rf /tmp/upx.tar.xz "/tmp/${UPX_DIR}"; \
    echo "[${TARGETPLATFORM:-unknown}] --- UPX 安装的 ---"; \
    upx --version

# 4. 安装 Node.js 工具
# GitHub / GitLab runner 默认直连官方源，npm / pnpm 不设 registry（用官方默认 registry.npmjs.org）。
RUN set -eux; \
    ARCH="$(uname -m)"; \
    case "$ARCH" in \
    x86_64) NODE_ARCH="x64" ;; \
    aarch64) NODE_ARCH="arm64" ;; \
    *) echo "[${TARGETPLATFORM:-unknown}] 不支持的架构: $ARCH" >&2; exit 1 ;; \
    esac; \
    NODE_BASE="https://nodejs.org/dist"; \
    if [ "${NODE_VERSION}" = "latest" ]; then \
    NODE_TAG="$(curl -fsSL "${NODE_BASE}/index.json" | jq -r '[.[] | select(.version | test("-") | not)][0].version')"; \
    else NODE_TAG="v${NODE_VERSION}"; fi; \
    case "${NODE_TAG}" in \
    v[0-9]*) : ;; \
    *) echo "[${TARGETPLATFORM:-unknown}] 无法解析 Node.js 版本（NODE_VERSION=${NODE_VERSION}，得到：${NODE_TAG:-空}）" >&2; exit 1 ;; \
    esac; \
    NODE_VER="${NODE_TAG#v}"; \
    echo "[${TARGETPLATFORM:-unknown}] Node.js 版本解析为 ${NODE_TAG}"; \
    NODE_DIR="node-${NODE_TAG}-linux-${NODE_ARCH}"; \
    NODE_URL="${NODE_BASE}/${NODE_TAG}/${NODE_DIR}.tar.xz"; \
    wget -q -O /tmp/node.tar.xz "${NODE_URL}"; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1; \
    npm install -g pnpm@${PNPM_VERSION}; \
    pnpm config set ignore-scripts false; \
    rm -rf /tmp/node.tar.xz /root/.npm /root/.cache/node; \
    echo "[${TARGETPLATFORM:-unknown}] --- Node.js 安装的 (v${NODE_VER}) ---"; \
    node -v && npm -v && pnpm -v

# 5.0 二进制安装助手
# 官方 Release 二进制优先：下载即用、不用编译，比 go install 快很多；脚本内部按
# 「镜像 → 官方源」两次尝试，都失败返回非 0，由下面的层回退 go install。
# 变体镜像（FROM 本镜像）自动继承这个脚本，wails2/wails3 等也能直接用。
COPY --chmod=0755 .gitlab/docker/install-tool.sh /usr/local/bin/install-tool

# 5. 安装 Go 工具链（含 nfpm）
# 每个工具先试官方二进制 install-tool <名> <版本>，失败再 go install（走 GOPROXY 编译）。
# 按工具分组拆层 + BuildKit 缓存挂载：
#   · 拆层：某个工具发版时只重建它所在的那一层，不用所有工具全部重装；
#   · --mount=type=cache：模块缓存与编译缓存留在构建节点、不进入镜像层，
#     所以不再需要「同一层内 rm -rf /go/pkg/mod /root/.cache/go-build」。
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    set -eux; \
    install-tool nfpm "${NFPM_VERSION}" \
    || go install -v github.com/goreleaser/nfpm/v2/cmd/nfpm@${NFPM_VERSION}; \
    echo "[${TARGETPLATFORM:-unknown}] ==> nfpm 安装完成 (${NFPM_VERSION})"; \
    install-tool sqlc "${SQLC_VERSION}" \
    || go install -v github.com/sqlc-dev/sqlc/cmd/sqlc@${SQLC_VERSION}; \
    echo "[${TARGETPLATFORM:-unknown}] ==> sqlc 安装完成 (${SQLC_VERSION})"

# 5.1 ent / entc（官方不发二进制，只能 go install）
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    set -eux; \
    go install -v entgo.io/ent/cmd/ent@${ENT_VERSION}; \
    go install -v entgo.io/ent/cmd/entc@${ENT_VERSION}; \
    echo "[${TARGETPLATFORM:-unknown}] ==> ent / entc 安装完成 (${ENT_VERSION})"

# 5.2 golangci-lint / govulncheck（golangci-lint 有二进制，govulncheck 没有）
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    set -eux; \
    install-tool golangci-lint "${GOLANGCI_LINT_VERSION}" \
    || go install -v github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION}; \
    echo "[${TARGETPLATFORM:-unknown}] ==> golangci-lint 安装完成 (${GOLANGCI_LINT_VERSION})"; \
    go install -v golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION}; \
    echo "[${TARGETPLATFORM:-unknown}] ==> govulncheck 安装完成 (${GOVULNCHECK_VERSION})"

# 5.3 格式化与数据处理：shfmt / dockerfmt / yamlfmt / gojq / markdownfmt / sql-formatter
# markdownfmt 没有官方二进制，其余五个优先下载。
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    set -eux; \
    install-tool shfmt "${SHFMT_VERSION}" \
    || go install -v mvdan.cc/sh/v3/cmd/shfmt@${SHFMT_VERSION}; \
    echo "[${TARGETPLATFORM:-unknown}] ==> shfmt 安装完成 (${SHFMT_VERSION})"; \
    install-tool dockerfmt "${DOCKERFMT_VERSION}" \
    || go install -v github.com/reteps/dockerfmt@${DOCKERFMT_VERSION}; \
    echo "[${TARGETPLATFORM:-unknown}] ==> dockerfmt 安装完成 (${DOCKERFMT_VERSION})"; \
    install-tool yamlfmt "${YAMLFMT_VERSION}" \
    || go install -v github.com/google/yamlfmt/cmd/yamlfmt@${YAMLFMT_VERSION}; \
    echo "[${TARGETPLATFORM:-unknown}] ==> yamlfmt 安装完成 (${YAMLFMT_VERSION})"; \
    install-tool gojq "${GOJQ_VERSION}" \
    || go install -v github.com/itchyny/gojq/cmd/gojq@${GOJQ_VERSION}; \
    echo "[${TARGETPLATFORM:-unknown}] ==> gojq 安装完成 (${GOJQ_VERSION})"; \
    go install -v github.com/Kunde21/markdownfmt/v3/cmd/markdownfmt@${MARKDOWNFMT_VERSION}; \
    echo "[${TARGETPLATFORM:-unknown}] ==> markdownfmt 安装完成 (${MARKDOWNFMT_VERSION})"; \
    install-tool sql-formatter "${GOSQLFORMATTER_VERSION}" \
    || go install -v github.com/wasilibs/go-sql-formatter/v15/cmd/sql-formatter@${GOSQLFORMATTER_VERSION}; \
    echo "[${TARGETPLATFORM:-unknown}] ==> go-sql-formatter 安装完成 (${GOSQLFORMATTER_VERSION})"

# 5.4 测试与覆盖率报告：gotestsum / gocover-cobertura / gcov2lcov
# 三者是同一条链路：gotestsum 跑测试并出 JUnit，go test -coverprofile 出覆盖率，
# gocover-cobertura / gcov2lcov 再转成 cobertura / lcov。前两者有二进制、
# gocover-cobertura 没有。
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    set -eux; \
    install-tool gotestsum "${GOTESTSUM_VERSION}" \
    || go install -v gotest.tools/gotestsum@${GOTESTSUM_VERSION}; \
    echo "[${TARGETPLATFORM:-unknown}] ==> gotestsum 安装完成 (${GOTESTSUM_VERSION})"; \
    go install -v github.com/boumenot/gocover-cobertura@${GOCOVER_COBERTURA_VERSION}; \
    echo "[${TARGETPLATFORM:-unknown}] ==> gocover-cobertura 安装完成 (${GOCOVER_COBERTURA_VERSION})"; \
    install-tool gcov2lcov "${GCOV2LCOV_VERSION}" \
    || go install -v github.com/jandelgado/gcov2lcov@${GCOV2LCOV_VERSION}; \
    echo "[${TARGETPLATFORM:-unknown}] ==> gcov2lcov 安装完成 (${GCOV2LCOV_VERSION})"; \
    echo "[${TARGETPLATFORM:-unknown}] --- Go 工具链安装完成 ---"; \
    ls -l "$GOPATH/bin" /usr/local/bin

# 5.5 任务编排：task（go-task）
# Taskfile 的任务运行器；镜像里装好，容器内可直接 task <name>，不用再 go install。
# 官方有 linux/amd64、linux/arm64 二进制。
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    set -eux; \
    install-tool task "${TASK_VERSION}" \
    || go install -v github.com/go-task/task/v3/cmd/task@${TASK_VERSION}; \
    echo "[${TARGETPLATFORM:-unknown}] ==> task 安装完成 (${TASK_VERSION})"

# 6. 清空所有 apt 缓存（保留 wget / xz-utils，不卸载）
RUN apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /root/.npm

# -------------------------------------------------------------------
# OCI 元数据标签
# 放在最后：BUILD_DATE / VCS_REF / IMAGE_VERSION 每次构建都变，放在前面会让
# apt、Node、go install 这些层的缓存键跟着每次提交一起变，层缓存直接失效。
# -------------------------------------------------------------------
LABEL org.opencontainers.image.source="${IMAGE_SOURCE}" \
    org.opencontainers.image.url="${IMAGE_SOURCE}" \
    org.opencontainers.image.revision="${VCS_REF}" \
    org.opencontainers.image.created="${BUILD_DATE}" \
    org.opencontainers.image.version="${IMAGE_VERSION}" \
    org.opencontainers.image.description="Golang 构建环境：Go 工具链 + UPX + nfpm + Node.js/pnpm + sqlc、ent、golangci-lint、govulncheck、shfmt、dockerfmt、yamlfmt、gojq、sql-formatter、gotestsum、markdownfmt、task、wixl、gocover-cobertura、gcov2lcov" \
    org.opencontainers.image.licenses="MIT" \
    org.opencontainers.image.base.name="golang:${GO_VERSION}-${DEBIAN_VERSION}" \
    org.opencontainers.image.base.digest="${BASE_DIGEST}"

CMD ["bash"]
