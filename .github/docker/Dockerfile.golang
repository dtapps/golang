# ===================================================================
# Golang 构建环境镜像（不含 fnpack）
#
# 两个平台各留一份：.cnb/docker/Dockerfile.golang 与
# .github/docker/Dockerfile.golang，各自维护、不互相引用。
# 装包、升级工具版本时两处都要改；镜像源按平台不同（见各步骤注释）。
#
# 镜像内容：
#   Go 工具链 + UPX + nfpm + Node.js/pnpm
#   + sqlc / ent / golangci-lint / govulncheck / shfmt / dockerfmt / yamlfmt
#   + gojq / sql-formatter / gotestsum / markdownfmt
#
# 工具版本默认 latest，构建时自动解析最新版（详见下方版本变量注释块）。
# ===================================================================

# GO_VERSION 默认 1 = golang:1-trixie 浮动标签，自动跟随最新稳定 Go（跨大版本）。
# 钉版本传 1.27 或 1.27.3。构建脚本会把解析出的实际 Go 版本写进镜像标签。
ARG GO_VERSION=1
ARG DEBIAN_VERSION=trixie
FROM golang:${GO_VERSION}-${DEBIAN_VERSION}

# FROM 之前声明的 ARG 在构建阶段不可见，必须在此重新声明才能用于 LABEL
ARG GO_VERSION
ARG DEBIAN_VERSION
ARG IMAGE_VERSION=dev
ARG VCS_REF=unknown
# 默认值取固定纪元时间而非当前时间：不传参时同一份源码构建出同样的镜像 config
ARG BUILD_DATE=1970-01-01T00:00:00Z
# 基础镜像的 manifest digest（CI 解析后传入）
ARG BASE_DIGEST=unknown
# 本镜像所在的代码仓库（OCI source/url），由构建脚本传入
ARG IMAGE_SOURCE

# -------------------------------------------------------------------
# OCI 元数据标签
# -------------------------------------------------------------------
LABEL org.opencontainers.image.source="${IMAGE_SOURCE}" \
    org.opencontainers.image.url="${IMAGE_SOURCE}" \
    org.opencontainers.image.revision="${VCS_REF}" \
    org.opencontainers.image.created="${BUILD_DATE}" \
    org.opencontainers.image.version="${IMAGE_VERSION}" \
    org.opencontainers.image.description="Golang 构建环境：Go 工具链 + UPX + nfpm + Node.js/pnpm + sqlc、ent、golangci-lint、govulncheck、shfmt、dockerfmt、yamlfmt、gojq、sql-formatter、gotestsum、markdownfmt" \
    org.opencontainers.image.licenses="MIT" \
    org.opencontainers.image.base.name="golang:${GO_VERSION}-${DEBIAN_VERSION}" \
    org.opencontainers.image.base.digest="${BASE_DIGEST}"

# ==========================================
# 工具版本：默认 latest，构建时自动解析最新版。
# cron / 手动触发不传参 = 永远最新；出问题时可钉回具体版本：
#   --build-arg SQLC_VERSION=v1.31.1（或直接改这里的默认值）
#
# latest 的解析渠道（jq 在第 2 步安装）：
#   UPX        releases.atom 第一个稳定 tag（不走 api.github.com：免认证、
#              无 60 次/小时限速，解析命令与 CNB 侧完全一致）
#   Node       nodejs.org/dist/index.json 第一个非预发布版本（过滤 -alpha/-rc）
#   nfpm       go install @latest（走 GOPROXY；钉版本格式 vX.Y.Z）
#   Go 工具链  go install @latest（模块路径含 /v2、/v3，不会自动跳 major）
#   pnpm       npm registry 的 pnpm@latest
#
# https://github.com/upx/upx/releases
# https://github.com/goreleaser/nfpm/releases
# https://github.com/nodejs/node/releases
# https://github.com/pnpm/pnpm/releases
# https://github.com/ent/ent/releases
# https://github.com/sqlc-dev/sqlc/releases
# https://github.com/golangci/golangci-lint/releases
# https://go.googlesource.com/vuln
# https://github.com/mvdan/sh/releases
# https://github.com/reteps/dockerfmt/releases
# https://github.com/google/yamlfmt/releases
# https://github.com/itchyny/gojq/releases
# https://github.com/wasilibs/go-sql-formatter/releases
# https://github.com/gotestyourself/gotestsum/releases
# https://github.com/Kunde21/markdownfmt/releases
# ==========================================
ARG UPX_VERSION=latest
ARG NFPM_VERSION=latest
ARG NODE_VERSION=latest
ARG PNPM_VERSION=latest
ARG ENT_VERSION=latest
ARG SQLC_VERSION=latest
ARG GOLANGCI_LINT_VERSION=latest
ARG GOVULNCHECK_VERSION=latest
ARG SHFMT_VERSION=latest
ARG DOCKERFMT_VERSION=latest
ARG YAMLFMT_VERSION=latest
ARG GOJQ_VERSION=latest
ARG GOSQLFORMATTER_VERSION=latest
ARG GOTESTSUM_VERSION=latest
ARG MARKDOWNFMT_VERSION=latest

# 1. 设置 Go 环境变量
ENV GOPATH=/go \
    PATH="$GOPATH/bin:$PATH"

# 2. 安装基础构建工具
RUN export DEBIAN_FRONTEND=noninteractive; \
    apt-get update && apt-get install -y --no-install-recommends \
    wget \
    xz-utils \
    ca-certificates \
    curl \
    gnupg \
    git \
    make \
    jq \
    && rm -rf /var/lib/apt/lists/*

# 3. 安装 UPX 工具
RUN set -eux; \
    ARCH="$(uname -m)"; \
    case "$ARCH" in \
    x86_64) UPX_ARCH="amd64" ;; \
    aarch64) UPX_ARCH="arm64" ;; \
    *) echo "不支持的架构: $ARCH" >&2; exit 1 ;; \
    esac; \
    GH="https://github.com"; \
    if [ "${UPX_VERSION}" = "latest" ]; then \
    UPX_TAG="$(curl -fsSL "${GH}/upx/upx/releases.atom" \
    | grep -oE 'releases/tag/v[0-9]+\.[0-9]+\.[0-9]+"' | head -n 1 \
    | sed 's|.*/tag/||; s|"||')"; \
    else UPX_TAG="v${UPX_VERSION}"; fi; \
    case "${UPX_TAG}" in \
    v[0-9]*) : ;; \
    *) echo "无法解析 UPX 版本（UPX_VERSION=${UPX_VERSION}，得到：${UPX_TAG:-空}）" >&2; exit 1 ;; \
    esac; \
    UPX_VER="${UPX_TAG#v}"; \
    UPX_DIR="upx-${UPX_VER}-${UPX_ARCH}_linux"; \
    UPX_URL="${GH}/upx/upx/releases/download/${UPX_TAG}/${UPX_DIR}.tar.xz"; \
    wget -q -O /tmp/upx.tar.xz "${UPX_URL}"; \
    tar -xJf /tmp/upx.tar.xz -C /tmp; \
    mv "/tmp/${UPX_DIR}/upx" /usr/local/bin/upx; \
    chmod +x /usr/local/bin/upx; \
    rm -rf /tmp/upx.tar.xz "/tmp/${UPX_DIR}"; \
    echo "--- UPX 安装的 ---"; \
    upx --version

# 4. 安装 Node.js 工具
RUN set -eux; \
    ARCH="$(uname -m)"; \
    case "$ARCH" in \
    x86_64) NODE_ARCH="x64" ;; \
    aarch64) NODE_ARCH="arm64" ;; \
    *) echo "不支持的架构: $ARCH" >&2; exit 1 ;; \
    esac; \
    NODE_BASE="https://nodejs.org/dist"; \
    if [ "${NODE_VERSION}" = "latest" ]; then \
    NODE_TAG="$(curl -fsSL "${NODE_BASE}/index.json" | jq -r '[.[] | select(.version | test("-") | not)][0].version')"; \
    else NODE_TAG="v${NODE_VERSION}"; fi; \
    case "${NODE_TAG}" in \
    v[0-9]*) : ;; \
    *) echo "无法解析 Node.js 版本（NODE_VERSION=${NODE_VERSION}，得到：${NODE_TAG:-空}）" >&2; exit 1 ;; \
    esac; \
    NODE_VER="${NODE_TAG#v}"; \
    echo "Node.js 版本解析为 ${NODE_TAG}"; \
    NODE_DIR="node-${NODE_TAG}-linux-${NODE_ARCH}"; \
    NODE_URL="${NODE_BASE}/${NODE_TAG}/${NODE_DIR}.tar.xz"; \
    wget -q -O /tmp/node.tar.xz "${NODE_URL}"; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1; \
    npm config set registry https://mirrors.cloud.tencent.com/npm/; \
    npm install -g pnpm@${PNPM_VERSION}; \
    pnpm config set registry https://mirrors.cloud.tencent.com/npm/; \
    pnpm config set ignore-scripts false; \
    rm -rf /tmp/node.tar.xz /root/.npm /root/.cache/node; \
    echo "--- Node.js 安装的 (v${NODE_VER}) ---"; \
    node -v && npm -v && pnpm -v

# 5. 预安装 Go 工具链（含 nfpm，走 GOPROXY @latest）
# 同一层内 go install + 清缓存，避免 go-build 和 mod 缓存留在独立层里
RUN echo "==> 预安装 Go 工具链..." \
    && go install github.com/goreleaser/nfpm/v2/cmd/nfpm@${NFPM_VERSION} \
    && echo "==> nfpm 安装完成 (${NFPM_VERSION})" \
    && go install github.com/sqlc-dev/sqlc/cmd/sqlc@${SQLC_VERSION} \
    && echo "==> sqlc 安装完成 (${SQLC_VERSION})" \
    && go install entgo.io/ent/cmd/ent@${ENT_VERSION} \
    && go install entgo.io/ent/cmd/entc@${ENT_VERSION} \
    && echo "==> ent / entc 安装完成 (${ENT_VERSION})" \
    && go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION} \
    && echo "==> golangci-lint 安装完成 (${GOLANGCI_LINT_VERSION})" \
    && go install golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION} \
    && echo "==> govulncheck 安装完成 (${GOVULNCHECK_VERSION})" \
    && go install mvdan.cc/sh/v3/cmd/shfmt@${SHFMT_VERSION} \
    && echo "==> shfmt 安装完成 (${SHFMT_VERSION})" \
    && go install github.com/reteps/dockerfmt@${DOCKERFMT_VERSION} \
    && echo "==> dockerfmt 安装完成 (${DOCKERFMT_VERSION})" \
    && go install github.com/google/yamlfmt/cmd/yamlfmt@${YAMLFMT_VERSION} \
    && echo "==> yamlfmt 安装完成 (${YAMLFMT_VERSION})" \
    && go install github.com/itchyny/gojq/cmd/gojq@${GOJQ_VERSION} \
    && echo "==> gojq 安装完成 (${GOJQ_VERSION})" \
    && go install github.com/wasilibs/go-sql-formatter/v15/cmd/sql-formatter@${GOSQLFORMATTER_VERSION} \
    && echo "==> go-sql-formatter 安装完成 (${GOSQLFORMATTER_VERSION})" \
    && go install gotest.tools/gotestsum@${GOTESTSUM_VERSION} \
    && echo "==> gotestsum 安装完成 (${GOTESTSUM_VERSION})" \
    && go install github.com/Kunde21/markdownfmt/v3/cmd/markdownfmt@${MARKDOWNFMT_VERSION} \
    && echo "==> markdownfmt 安装完成 (${MARKDOWNFMT_VERSION})" \
    && echo "--- Go 工具链安装完成 ---" \
    && ls -l $GOPATH/bin \
    && rm -rf /root/.cache/go-build /go/pkg/mod

# 6. 卸载不需要的工具，并清空所有 apt 缓存
RUN apt-get purge -y wget xz-utils \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /root/.npm

CMD ["bash"]
